        "endSec": 6.45,
        "provenance": "authored-adaptation"
      },
      {
        "speakerId": "chenjin",
        "speaker": "陈劲",
        "delivery": "on_screen",
        "text": "贺总，轮到你敲钟了。",
        "startSec": 7.55,
        "endSec": 12.45,
        "provenance": "authored-adaptation"
      }
    ],
    "note": null
  },
  {
    "nodeId": "ending_future",
    "lines": [
      {
        "speakerId": "hexingran",
        "speaker": "贺星冉",
        "delivery": "on_screen",
        "text": "到底是谁让你来救我的？",
        "startSec": 0.55,
        "endSec": 6.88,
        "provenance": "authored-adaptation"
      },
      {
        "speakerId": "chenjin",
        "speaker": "陈劲",
        "delivery": "on_screen",
        "text": "你。未来的你，花了一千万。",
        "startSec": 7.12,
        "endSec": 13.45,
        "provenance": "authored-adaptation"
      }
    ],
    "note": null
  },
  {
