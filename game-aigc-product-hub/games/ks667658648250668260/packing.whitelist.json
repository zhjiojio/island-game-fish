{
  "$comment": [
    "白名单：只有这里列出的路径/glob 才会被 preview.sh 拷贝到 dist/。",
    "新增文件必须先加白名单才会进包 —— 这样默认安全（漏加 = 不打包，反过来的问题）。",
    "如果发现包过大，改这个文件而不是改 project.config.json 的 ignore。",
    "打包策略/分包/CDN 完整说明看：docs/PACKAGING_STRATEGY.md"
  ],
  "include": [
    "game.js",
    "game.json",
    "index.html",
    "kwaiadapter.js",
    "events.js",
    "wxhelper.js",
    "css/**/*.css",
    "js/registry.js",
    "js/story.js",
    "js/main-v43.js",
    "js/achievements.js",
    "js/subtitles.js",
    "js/ks-adapter.js",
    "js/icons.js",
    "js/assets.js",
    "assets/audio/**/*.mp3",
    "assets/audio/**/*.m4a",
    "assets/videos/**/*.mp4",
    "assets/frames/**/*.jpg",
    "assets/frames/index.js",
    "assets/lastframe/**/*.jpg",
    "assets/lastframe/**/*.png",
    "assets/poster/*.jpg",
    "assets/poster/*.png",
    "assets/sfx/**/*.mp3",
    "assets/sfx/**/*.wav",
    "assets/icons/**/*.png",
    "assets/icons/**/*.svg",
    "assets/ui/**/*.png",
    "assets/ui/**/*.jpg",
    "assets/avatars/**/*.png",
    "assets/avatars/**/*.jpg",
    "images/fx/dont-touch.png",
    "js/telemetry.js",
    "project.config.json"
  ],
  "exclude": [
    "js/_archive/**",
    "js/main-v42.js",
    "js/*.bak",
    "assets/refs/**",
    "assets/bridge/**",
    "assets/videos/*_original.mp4",
    "assets/videos_original/**",
    "assets/videos_compressed/**",
    "assets/bgm_original/**",
    "assets/bgm_compressed/**",
    "assets/bgm/**",
    "assets/_original_batch/**",
    "assets/_original_v2_batch/**",
    "assets/_cdn_compressed/**",
    "assets/audio/_narr_bak/**",
    "assets/**/*.bak.*",
    "assets/**/*.orig.*",
    "assets/frames/*.png",
    "assets/frames/r_side07_frame*.*",
    "assets/frames/e3s3_v2.*",
    "avatars/*.png",
    "avatars/*.json",
    "**/*.DS_Store",
    "**/*.md",
    "**/README*"
  ],
  "budgetBytes": {
    "totalWarnAt": 18000000,
    "totalFatalAt": 20000000,
    "singleFileWarnAt": 4000000
  }
}
