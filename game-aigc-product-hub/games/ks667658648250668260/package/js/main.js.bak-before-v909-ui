  // V31·9-LOGIN · 参考老铁找茬王 welcome.js 完整三步走：
  //   login → getSetting → (authorize scope.userInfo) → getUserInfo({withCredentials:true, lang:'zh_CN'})
  //   ⚠️ 之前一直跳过 authorize + 没加 withCredentials，快手返回匿名"铁子"，拿不到真实头像昵称！
  function ksLogin (onSuccess, onFail) {
    onSuccess = onSuccess || function () { };
    onFail = onFail || function () { };
    if (state.user && state.user.nickName && !state.user.logging) { onSuccess(state.user); return; }
    state.user = state.user || {};
    state.user.logging = true;
    if (!isKS || !wx) {
      state.user = { nickName: '傲天玩家', avatarUrl: '', logging: false, mock: true };
      LG('LOGIN', 'web mock 用户');
      onSuccess(state.user);
      return;
    }

    function _finishOK (ui) {
      ui = ui || {};
      state.user = {
        nickName: ui.nickName || ui.nickname || ui.userName || '快手用户',
        avatarUrl: ui.avatarUrl || ui.avatar || ui.headImgUrl || '',
        logging: false
      };
      LG('USER-INFO', '✅ 拿到真实用户信息', { nick: state.user.nickName, hasAvatar: !!state.user.avatarUrl });
      if (state.user.avatarUrl) {
        try {
          var im = wx.createImage();
          im.onload = function () { state.user.avatarImg = im; };
          im.onerror = function (e) { LG('AVATAR-ERR', '头像下载失败'); };
          im.src = state.user.avatarUrl;
        } catch (e) { }
      }
      try { onSuccess(state.user); } catch (e) { }
    }
    function _finishFail (err) {
      LG('USER-INFO-FAIL', '登录/授权失败', { err: err && (err.errMsg || err.code) });
      state.user = { logging: false, nickName: '', avatarUrl: '' };
      try { onFail(err); } catch (e) { }
    }

    // 【第 3 步】真拉用户信息（此时已授权，加 withCredentials 才能拿真数据）
    function step3_getUserInfo () {
      try {
        if (!wx.getUserInfo) { _finishFail({ errMsg: 'no getUserInfo' }); return; }
        wx.getUserInfo({
          withCredentials: true,   // ⭐ 关键：告诉快手要真实签名过的信息
          lang: 'zh_CN',
          success: function (res) { _finishOK(res && res.userInfo); },
          fail: _finishFail
        });
      } catch (e) { _finishFail({ errMsg: e && e.message }); }
    }

    // 【第 2 步】授权 scope.userInfo
    function step2_authorize () {
      try {
        var settingCb = function (res) {
          var granted = res && res.authSetting && (res.authSetting['scope.userInfo'] === true);
          LG('AUTH-CHK', 'scope.userInfo', { granted: !!granted });
          if (granted) { step3_getUserInfo(); return; }
          if (!wx.authorize) { step3_getUserInfo(); return; }
          wx.authorize({
            scope: 'scope.userInfo',
            success: function () { LG('AUTH-OK', '用户授权通过'); step3_getUserInfo(); },
            fail: function (err) { LG('AUTH-FAIL', '用户拒绝授权', { err: err && err.errMsg }); _finishFail(err); }
          });
        };
        if (wx.getSetting) {
          wx.getSetting({ success: settingCb, fail: function () { step3_getUserInfo(); } });
        } else {
          step3_getUserInfo();
        }
      } catch (e) { _finishFail({ errMsg: e && e.message }); }
    }

    // 【第 1 步】login 拿 code
    try {
      if (wx.login) {
        wx.login({
          success: function (r) { LG('LOGIN-OK', 'ks.login', { code: r && r.code }); state.user._code = r && r.code; step2_authorize(); },
          fail: function (e) { LG('LOGIN-FAIL', 'ks.login 失败', { err: e && e.errMsg }); step2_authorize(); }
        });
      } else {
        step2_authorize();
      }
    } catch (e) { LG('LOGIN-EX', 'ks.login 异常', { err: e && e.message }); step2_authorize(); }
  }

