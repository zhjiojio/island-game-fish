# ============================================================
# 斗地主服务端环境变量
# 复制为 .env 或直接以环境变量方式注入（本项目不自动加载 .env）
# ============================================================

# ---- 认证模式（最重要）----
# strict : 正式环境。仅接受快手登录，游客一律拒绝。
# mixed  : 预发/灰度。快手登录优先，快手未配置时降级游客。
# dev    : 本地 H5 调试与自动化测试。允许游客。
#
# 【故意设计】不配置时默认 strict。
# 忘记配环境变量的后果应该是「登不进去」而不是「游客随便进」。
DDZ_AUTH_MODE=dev

# ---- 认证密钥（必填）----
# 用途：派生游客 accountId、签发 sessionToken。
# strict 模式下未配置会直接拒绝启动，避免用随机密钥上线导致重启即掉线。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 【禁止】提交真实密钥到仓库；轮换密钥会使所有 sessionToken 与游客身份失效。
DDZ_AUTH_SECRET=
# 关闭后不启用机器人补位，也不要求票据密钥。
DDZ_BOT_MATCH_ENABLED=true

# ---- 快手开放平台 ----
# appId 有默认值；appSecret 必须由部署环境或本地忽略的 .env 注入。
# 【禁止】提交真实 appSecret 到仓库；泄漏后立即在快手平台轮换密钥。
DDZ_KWAI_APP_ID=
DDZ_KWAI_APP_SECRET=
# 官方小游戏接口（GET + grant_type=authorization_code）
DDZ_KWAI_CODE2SESSION_URL=https://open.kuaishou.com/game/minigame/jscode2session
DDZ_KWAI_TIMEOUT_MS=5000
# 身份盐固定在 server/config/kwai-app.js，禁止通过环境变量覆盖。

# ---- 会话有效期 ----
# 默认 7 天。用户在有效期内重连无需重新登录。
DDZ_SESSION_TTL_MS=604800000

# ---- 新账号防刷 ----
# 同一 IP 在窗口内可创建的新账号数上限。
# 每个新账号会获得 20000 新手铁豆，不限流等于开放提款机。
DDZ_NEW_ACCOUNT_WINDOW_MS=3600000
DDZ_NEW_ACCOUNT_MAX_PER_IP=20

# ---- 服务与存储 ----
PORT=8080
# 持久层强约束：仅支持 MySQL / InnoDB。
# 禁止配置 DDZ_DB_DIALECT=sqlite、DDZ_DB_PATH 或任何本地 .db 文件。

# ---- 语音互动与语音包交易 ----
# 语音总开关默认开启；关闭后不下发 voiceConfig，牌局其他功能不受影响。
DDZ_VOICE_CHAT_ENABLED=true
# 交易开关默认关闭。正式开启前必须先由 DBA 执行：
# scripts/migrations/20260813_trade_entitlements.sql
DDZ_VOICE_TRADE_ENABLED=false

# ---- 规则牌力评估（叫抢与加倍）----
# lite：默认的轻量结构牌力；v1：旧线性公式，仅用于紧急回滚。
DDZ_HAND_STRENGTH_MODE=lite

# ---- DouZero 机器人出牌（可选）----
# active：模型作为默认出牌策略；shadow：规则动作生效，后台比较模型；off：完全不访问模型。
# 模型服务启动失败、未就绪、超时、异常或响应非法时，自动使用现有规则 AI。
DDZ_DOUZERO_MODE=active
# Compose 内使用服务名 douzero；Node 单独本地运行时改为 http://127.0.0.1:2021。
DDZ_DOUZERO_URL=http://douzero:2021
DDZ_DOUZERO_TIMEOUT_MS=800
DDZ_DOUZERO_TRAFFIC_PERCENT=100
DDZ_DOUZERO_SHADOW_PERCENT=0
DDZ_DOUZERO_MODEL_VERSION=douzero-wp
# Node 单独运行时使用；Compose 会从下方 DOUZERO_MAX_CONCURRENT 注入相同值。
DDZ_DOUZERO_MAX_CONCURRENT=4
# Shadow 请求使用独立小容量，不抢占 active 推理槽位。
DDZ_DOUZERO_SHADOW_MAX_CONCURRENT=2
# 每累计多少个 shadow 结果输出一条无牌面聚合日志。
DDZ_DOUZERO_SHADOW_LOG_EVERY=100
# 正常动作按稳定键采样；模型动作和降级动作始终记录。0 表示只记录后两类。
DDZ_DOUZERO_DECISION_LOG_PERCENT=5
# 熔断窗口与冷却；窗口至少 10 次且失败率达到 50% 时打开。
DDZ_DOUZERO_CIRCUIT_WINDOW=20
DDZ_DOUZERO_CIRCUIT_COOLDOWN_MS=30000

# Sidecar 自身有界并发与资源限制。Compose 以此值同时配置 Node 主流量。
DOUZERO_MAX_CONCURRENT=4
DOUZERO_INTRA_OP_THREADS=1
DOUZERO_INTER_OP_THREADS=1
DOUZERO_CPUS=2.0
DOUZERO_MEMORY_LIMIT=2g
# 模型缓存优先：命中经 SHA-256 校验的本地缓存时从不联网。
# 本地开发可设 true，首次从固定 HuggingFace commit 下载 WP ONNX；失败时继续规则 AI。
# 正式环境建议设 false，并预置模型缓存或配置下方内网制品地址。
DOUZERO_AUTO_DOWNLOAD=true
# 未命中缓存时是否允许请求 HuggingFace。正式部署应为 false。
DOUZERO_ALLOW_HUGGINGFACE_DOWNLOAD=true
# 内网制品/镜像 URL 模板，支持 {filename}、{repository}、{revision}、{subdirectory}。
# 例：https://artifact.example.internal/douzero/{revision}/{filename}
DOUZERO_MODEL_DOWNLOAD_URL_TEMPLATE=
DOUZERO_DOWNLOAD_TIMEOUT_SECONDS=300
# 公共固定制品模式可设为 false；正式审核部署应设 true 并注入下列摘要。
DOUZERO_REQUIRE_APPROVED_MANIFEST_SHA256=false
# 由审核/制品系统注入审核后 manifest 文件的 SHA-256；不得提交固定值。
DOUZERO_APPROVED_MANIFEST_SHA256=

# ---- IAP 支付与平台托管币 ----
# IAP、Android/iOS 售卖及平台币兑换默认启用；无需配置功能开关。
# 快手 chargeBalance/freeBalance 是唯一付费币账本；本服务不保存或扣减本地钻石余额。
# 必须通过部署 Secret 注入以下两项密钥。
DDZ_KWAI_PAY_SIGN_KEY=
DDZ_KWAI_PAY_NOTIFY_KEY=
# 受信反向代理的直连 IP，逗号分隔。仅这些来源可通过 X-Forwarded-For 传递真实用户 IP；留空时始终使用 socket IP。
DDZ_TRUSTED_PROXY_IPS=

# Compose 不启动 MySQL 镜像，也不会建库或建表。由部署环境提供正式实例 IP 或域名。
# schema 迁移须由 DBA 或独立发布任务执行；Node.js 启动时只校验 schema 是否就绪。
DDZ_MYSQL_HOST=
DDZ_MYSQL_PORT=3306
DDZ_MYSQL_USER=
DDZ_MYSQL_PASSWORD=
DDZ_MYSQL_DATABASE=
# 正式实例默认启用 TLS；仅本地非 TLS 实例才显式设为 false。
DDZ_MYSQL_SSL=true
DDZ_MYSQL_CONNECT_TIMEOUT_MS=5000

# 匹配资产区间（真人配对要求双方余额互相在 ±30% 以内；默认关闭）
# DDZ_MATCH_ASSET_BAND_ENABLED=false
