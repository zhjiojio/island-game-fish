# ============================================================
# 正式环境（阿里云 ACK）——非敏感配置
# ------------------------------------------------------------
# 本文件可进 Git，禁止填写任何密钥、口令、access token。
# 敏感项通过 K8s Secret（ddz-prod-secret）注入，清单见文件末尾。
# 变量含义以 server/.env.example 为准，此处只覆盖与环境相关的值。
# ============================================================

# ---- 运行时 ----
PORT=8080
# 正式环境只接受快手登录，游客一律拒绝。
DDZ_AUTH_MODE=strict

# ---- MySQL（阿里云 RDS 内网地址，需按实际实例填写）----
DDZ_MYSQL_HOST=
DDZ_MYSQL_PORT=3306
DDZ_MYSQL_USER=
DDZ_MYSQL_DATABASE=
DDZ_MYSQL_SSL=true
DDZ_MYSQL_CONNECT_TIMEOUT_MS=5000
DDZ_MYSQL_CONNECTION_LIMIT=20
# 正式库不允许应用建库；schema 由 DBA 或独立发布任务执行。
DDZ_MYSQL_CREATE_DATABASE=false

# SLB/Ingress 直连 IP，逗号分隔；未配置时忽略 X-Forwarded-For。
DDZ_TRUSTED_PROXY_IPS=

# ---- 快手开放平台（凭证走 Secret，此处只放非敏感项）----
DDZ_KWAI_CODE2SESSION_URL=https://open.kuaishou.com/game/minigame/jscode2session
DDZ_KWAI_TIMEOUT_MS=5000

# ---- IAP 与平台币兑换 ----
# 默认启用；签名与回调验签密钥由 Secret 注入，无需配置开关。

# ---- 语音 ----
DDZ_VOICE_CHAT_ENABLED=true
# 开启前需先执行 scripts/migrations/20260813_trade_entitlements.sql
DDZ_VOICE_TRADE_ENABLED=false

# ---- AI 决策 ----
DDZ_HAND_STRENGTH_MODE=lite
DDZ_DOUZERO_MODE=active
# 集群内 Service 地址，按实际 Service 名调整。
DDZ_DOUZERO_URL=http://ddz-douzero:2021
DDZ_DOUZERO_TIMEOUT_MS=800
DDZ_DOUZERO_MAX_CONCURRENT=4

# ---- DouZero Sidecar：正式环境不依赖公网 HuggingFace ----
DOUZERO_MAX_CONCURRENT=4
DOUZERO_AUTO_DOWNLOAD=false
DOUZERO_ALLOW_HUGGINGFACE_DOWNLOAD=false
# 预置模型缓存，或填写内网/OSS 制品地址模板。
DOUZERO_MODEL_DOWNLOAD_URL_TEMPLATE=
DOUZERO_REQUIRE_APPROVED_MANIFEST_SHA256=true

# ============================================================
# 由 K8s Secret（ddz-prod-secret）注入，禁止出现在本文件与镜像中：
#   DDZ_AUTH_SECRET
#   DDZ_MYSQL_PASSWORD
#   DDZ_KWAI_APP_SECRET
#   DDZ_KWAI_PAY_SIGN_KEY
#   DDZ_KWAI_PAY_NOTIFY_KEY
#   DOUZERO_APPROVED_MANIFEST_SHA256
# 注意：正式凭证与测试环境必须完全隔离，禁止复用。
# ============================================================
